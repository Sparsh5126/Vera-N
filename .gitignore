# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Impeccable working files (screenshots, downloaded references, decision-page logs)
.impeccable/review/
.impeccable/refs/
.impeccable/questions/
.impeccable/config.local.json

# Sync engine binaries, fetched by tool/fetch_sync_engine.ps1 (pinned hashes)
/windows/sync_engine/
/android/app/src/main/jniLibs/*/libsyncthingnative.so

# goldie renders (store screenshots, preview video, studio data)
goldie/out/
# argent screen recordings (local checks only)
.argent/recordings/
# goldie studio exports (the finished set is copied to docs/media)
/appstore-assets.zip
# /brag launch-video renders and their work files (the video is copied to docs/media)
/brag-output*/
