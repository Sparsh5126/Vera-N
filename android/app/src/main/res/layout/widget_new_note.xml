<?xml version="1.0" encoding="utf-8"?>
<!-- New note button (2x1): a large amber plus and "New note". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="@dimen/widget_padding">
    <ImageView
        android:layout_width="@dimen/widget_icon_large"
        android:layout_height="@dimen/widget_icon_large"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_plus" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/widget_gap"
        android:maxLines="1"
        android:text="@string/widget_new_note"
        android:textColor="@color/widget_text"
        android:textSize="@dimen/widget_text" />
</LinearLayout>
